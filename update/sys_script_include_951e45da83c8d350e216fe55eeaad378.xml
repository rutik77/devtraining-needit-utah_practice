        <caller_access/>
        <client_callable>true</client_callable>
        <description>Script Include to return an email address. The calling client-side script passes a sys_id for a User table record.&#13;
</description>
        <mobile_callable>false</mobile_callable>
        <name>needitexGetEmailAddress</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var needitexGetEmailAddress = Class.create();
needitexGetEmailAddress.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	getEmail: function(){
		var userRecord=new GlideRecord("sys_user");
		userRecord.get(this.getParameter('sysparm_userID'));
		return userRecord.email+'';
	},

    type: 'needitexGetEmailAddress'
});]]></script>
